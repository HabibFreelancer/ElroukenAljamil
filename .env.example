# =============================================================
# ELROUKEN ALJAMIL — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs réelles.
# Le fichier .env est gitignorée et ne doit JAMAIS être commité.
# =============================================================

# SQL Server
SA_PASSWORD=<mot-de-passe-sqlserver-fort>

# RabbitMQ
RABBITMQ_USER=<utilisateur-rabbitmq>
RABBITMQ_PASSWORD=<mot-de-passe-rabbitmq>

# JWT (minimum 32 caractères, générer avec : openssl rand -base64 48)
JWT_SECRET=<cle-jwt-minimum-32-caracteres>

# MinIO
MINIO_ACCESS_KEY=<access-key-minio>
MINIO_SECRET_KEY=<secret-key-minio>

# Brevo (Notification service)
BREVO_SMTP_USER=<login-smtp-brevo>
BREVO_SMTP_PASSWORD=<cle-smtp-brevo>
BREVO_API_KEY=<cle-api-brevo-v3>

# HuggingFace (Listings AI service)
HUGGINGFACE_TOKEN=<token-huggingface>

# Elasticsearch (optionnel si xpack.security activé)
ELASTIC_USER=
ELASTIC_PASSWORD=

# HashiCorp Vault (Staging / Production uniquement)
# Générer avec : bash vault/init-vault.sh
VAULT_TOKEN=<token-service-vault>
