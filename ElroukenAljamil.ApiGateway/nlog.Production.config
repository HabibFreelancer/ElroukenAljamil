<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true" throwConfigExceptions="false"
      internalLogLevel="Error" internalLogFile="${basedir}/logs/nlog-internal.log">
  <extensions><add assembly="NLog.Web.AspNetCore"/></extensions>
  <targets async="true">

    <target xsi:type="File" name="json"
            fileName="${basedir}/logs/gateway-${shortdate}.json"
            archiveFileName="${basedir}/logs/archives/gateway-{#}.json"
            archiveEvery="Day" archiveNumbering="DateAndSequence" maxArchiveFiles="30"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" includeEventProperties="true" includeScopeProperties="true">
        <attribute name="timestamp"   layout="${date:universalTime=true:format=yyyy-MM-ddTHH\:mm\:ss.fffZ}" />
        <attribute name="level"       layout="${level:lowercase=true}" />
        <attribute name="service"     layout="api-gateway" />
        <attribute name="environment" layout="${environment:ASPNETCORE_ENVIRONMENT:whenEmpty=Production}" />
        <attribute name="logger"      layout="${logger:shortName=true}" />
        <attribute name="message"     layout="${message:raw=true}" />
        <attribute name="trace_id"    layout="${aspnet-traceidentifier}" />
        <attribute name="http_method" layout="${aspnet-request-method}" />
        <attribute name="http_url"    layout="${aspnet-request-url:includeQueryString=true}" />
        <attribute name="http_status" layout="${aspnet-response-statuscode}" />
        <attribute name="client_ip"   layout="${aspnet-request-ip}" />
        <attribute name="user_id"     layout="${aspnet-user-identity}" />
        <attribute name="duration_ms" layout="${aspnet-request-duration}" />
        <attribute name="exception"   layout="${exception:format=@}" encode="false" />
      </layout>
    </target>

    <target xsi:type="File" name="errors"
            fileName="${basedir}/logs/gateway-errors-${shortdate}.json"
            archiveFileName="${basedir}/logs/archives/gateway-errors-{#}.json"
            archiveEvery="Day" archiveNumbering="DateAndSequence" maxArchiveFiles="90"
            encoding="utf-8">
      <layout xsi:type="JsonLayout" includeEventProperties="true">
        <attribute name="timestamp"   layout="${date:universalTime=true:format=yyyy-MM-ddTHH\:mm\:ss.fffZ}" />
        <attribute name="level"       layout="${level:lowercase=true}" />
        <attribute name="service"     layout="api-gateway" />
        <attribute name="environment" layout="${environment:ASPNETCORE_ENVIRONMENT:whenEmpty=Production}" />
        <attribute name="logger"      layout="${logger}" />
        <attribute name="message"     layout="${message:raw=true}" />
        <attribute name="trace_id"    layout="${aspnet-traceidentifier}" />
        <attribute name="http_method" layout="${aspnet-request-method}" />
        <attribute name="http_url"    layout="${aspnet-request-url:includeQueryString=true}" />
        <attribute name="http_status" layout="${aspnet-response-statuscode}" />
        <attribute name="client_ip"   layout="${aspnet-request-ip}" />
        <attribute name="user_id"     layout="${aspnet-user-identity}" />
        <attribute name="exception"   layout="${exception:format=@}" encode="false" />
      </layout>
    </target>

  </targets>
  <rules>
    <logger name="Microsoft.*" maxlevel="Warn"  final="true" />
    <logger name="System.*"    maxlevel="Warn"  final="true" />
    <logger name="Ocelot.*"    maxlevel="Error" final="true" />
    <logger name="*" minlevel="Error" writeTo="errors" />
    <logger name="*" minlevel="Warn"  writeTo="json" />
  </rules>
</nlog>
