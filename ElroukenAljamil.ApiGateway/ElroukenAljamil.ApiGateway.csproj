<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
	<ItemGroup>
		<!-- Ocelot : reverse proxy et routage vers les microservices -->
		<PackageReference Include="Ocelot" Version="23.0.*" />
		<!-- Cache des réponses au niveau du gateway -->
		<PackageReference Include="Ocelot.Cache.CacheManager" Version="23.0.*" />
		<!-- Rate Limiting intégré à Ocelot -->
		<PackageReference Include="Ocelot.Provider.Polly" Version="23.0.*" />
		<!-- Swagger agrégé pour tous les microservices -->
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.*" />
		<!-- JWT pour valider les tokens avant de router -->
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.*" />
		<!-- Health checks agrégés -->
		<PackageReference Include="AspNetCore.HealthChecks.UI" Version="8.0.*" />
		<PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" Version="8.0.*" />
		<!-- CORS -->
		<PackageReference Include="Microsoft.AspNetCore.Cors" Version="2.2.*" />
	</ItemGroup>
</Project>
