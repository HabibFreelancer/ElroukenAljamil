{
    "ConnectionStrings": {
        "RabbitMQ": "amqp://#{RABBITMQ_USER}#:#{RABBITMQ_PASSWORD}#@rabbitmq.elrouken.tn:5672/marketplace"
    },
    "Jwt": {
        "Secret": "#{JWT_SECRET}#",
        "Issuer": "Marketplace.Identity",
        "Audience": "Marketplace.Services"
    },
    "RabbitMQ": {
        "Host": "rabbitmq.elrouken.tn",
        "Port": 5672,
        "Username": "#{RABBITMQ_USER}#",
        "Password": "#{RABBITMQ_PASSWORD}#",
        "VirtualHost": "marketplace"
    },
    "Elasticsearch": {
        "Url": "https://elasticsearch.elrouken.tn:9200",
        "DefaultIndex": "listings",
        "Username": "#{ELASTIC_USER}#",
        "Password": "#{ELASTIC_PASSWORD}#"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Warning",
            "Microsoft.AspNetCore": "Warning",
            "Nest": "Warning"
        }
    }
}
