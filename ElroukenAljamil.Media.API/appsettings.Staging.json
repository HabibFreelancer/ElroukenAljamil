{
    "ConnectionStrings": {
        "MediaDb": "Server=sql-recette.elrouken.tn;Database=ElroukenMediaDb_Staging;User Id=#{DB_USER}#;Password=#{DB_PASSWORD}#;TrustServerCertificate=True",
        "RabbitMQ": "amqp://#{RABBITMQ_USER}#:#{RABBITMQ_PASSWORD}#@rabbitmq-recette.elrouken.tn:5672/marketplace"
    },
    "Jwt": {
        "Secret": "#{JWT_SECRET}#",
        "Issuer": "Marketplace.Identity",
        "Audience": "Marketplace.Services"
    },
    "RabbitMQ": {
        "Host": "rabbitmq-recette.elrouken.tn",
        "Port": 5672,
        "Username": "#{RABBITMQ_USER}#",
        "Password": "#{RABBITMQ_PASSWORD}#",
        "VirtualHost": "marketplace"
    },
    "EventBus": {
        "Host": "rabbitmq-recette.elrouken.tn",
        "Port": 5672,
        "Username": "#{RABBITMQ_USER}#",
        "Password": "#{RABBITMQ_PASSWORD}#",
        "VirtualHost": "marketplace"
    },
    "MinIO": {
        "Endpoint": "minio-recette.elrouken.tn:9000",
        "AccessKey": "#{MINIO_ACCESS_KEY}#",
        "SecretKey": "#{MINIO_SECRET_KEY}#",
        "UseSSL": true,
        "PublicUrl": "https://minio-recette.elrouken.tn"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    }
}
