{
    "ConnectionStrings": {
        "NotificationDb": "Server=sql-recette.elrouken.tn;Database=ElroukenNotificationDb_Staging;User Id=#{DB_USER}#;Password=#{DB_PASSWORD}#;TrustServerCertificate=True",
        "RabbitMQ": "amqp://#{RABBITMQ_USER}#:#{RABBITMQ_PASSWORD}#@rabbitmq-recette.elrouken.tn:5672/marketplace",
        "Redis": "redis-recette.elrouken.tn:6379"
    },
    "Jwt": {
        "Secret": "#{JWT_SECRET}#",
        "Issuer": "Marketplace.Identity",
        "Audience": "Marketplace.Services"
    },
    "RabbitMQ": {
        "Host": "rabbitmq-recette.elrouken.tn",
        "Port": 5672,
        "Username": "#{RABBITMQ_USER}#",
        "Password": "#{RABBITMQ_PASSWORD}#",
        "VirtualHost": "marketplace"
    },
    "Brevo": {
        "SmtpHost": "smtp-relay.brevo.com",
        "SmtpPort": 587,
        "SmtpUser": "#{BREVO_SMTP_USER}#",
        "SmtpPassword": "#{BREVO_SMTP_PASSWORD}#",
        "FromEmail": "noreply@recette.elrouken.tn",
        "FromName": "Elrouken Aljamil Recette",
        "ApiKey": "#{BREVO_API_KEY}#",
        "SmsSenderName": "ElroukenRec"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.SignalR": "Information",
            "Microsoft.EntityFrameworkCore": "Warning"
        }
    }
}
