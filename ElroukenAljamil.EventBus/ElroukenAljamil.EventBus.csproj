<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <Description>Bus d'événements partagé basé sur MassTransit et RabbitMQ pour la communication inter-services</Description>
	  <RootNamespace>ElroukenAljamil.BuildingBlocks.EventBus</RootNamespace>
  </PropertyGroup>
	<ItemGroup>
		<!-- MassTransit : abstraction du message broker -->
		<PackageReference Include="MassTransit" Version="8.2.5" />
		<!-- Transport RabbitMQ pour MassTransit -->
		<PackageReference Include="MassTransit.RabbitMQ" Version="8.2.5" />
		<!-- Injection de dépendances Microsoft -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
		<!-- Configuration Microsoft -->
		<PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
		<!-- Logging -->
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />


		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
	</ItemGroup>
</Project>
