{
    "ConnectionStrings": {
        "IdentityDb": "Server=sql-recette.elrouken.tn;Database=ElroukenIdentityDb_Staging;User Id=#{DB_USER}#;Password=#{DB_PASSWORD}#;TrustServerCertificate=True",
        "RabbitMQ": "amqp://#{RABBITMQ_USER}#:#{RABBITMQ_PASSWORD}#@rabbitmq-recette.elrouken.tn:5672/marketplace"
    },
    "Jwt": {
        "Secret": "#{JWT_SECRET}#",
        "Issuer": "Marketplace.Identity",
        "Audience": "Marketplace.Services",
        "ExpirationInMinutes": 60,
        "RefreshTokenExpirationDays": 7
    },
    "RabbitMQ": {
        "Host": "rabbitmq-recette.elrouken.tn",
        "Port": 5672,
        "Username": "#{RABBITMQ_USER}#",
        "Password": "#{RABBITMQ_PASSWORD}#",
        "VirtualHost": "marketplace"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    }
}
